diff --git a/ASFW/DVLiveCameraFeeder.swift b/ASFW/DVLiveCameraFeeder.swift
new file mode 100644
index 0000000..0f6724e
--- /dev/null
+++ b/ASFW/DVLiveCameraFeeder.swift
@@ -0,0 +1,398 @@
+//
+//  DVLiveCameraFeeder.swift
+//  ASFW
+//
+//  Feeds decoded MiniDV frames into the ASFWCamera CMIO sink so Photo Booth /
+//  Zoom see "Sony DCR-PC115E". The camera extension itself has no DriverKit
+//  access — this process owns DV capture via ASFWDriver.
+//
+
+import AVFoundation
+import CoreMedia
+import CoreMediaIO
+import CoreVideo
+import Foundation
+import os.log
+
+private let log = Logger(subsystem: "net.mrmidi.ASFW", category: "CameraFeeder")
+
+private let kCameraName = "Sony DCR-PC115E"
+private let kFrameWidth = 720
+private let kFrameHeight = 576
+private let kFrameRate: Int32 = 25
+private let kStreamingProperty = ASFWFourCC.code("just")
+
+@MainActor
+final class DVLiveCameraFeeder {
+    static let shared = DVLiveCameraFeeder()
+
+    private let pipeline = DVLivePipeline()
+    private var sourceStream: CMIOStreamID?
+    private var sinkStream: CMIOStreamID?
+    private var sinkDevice: CMIODeviceID?
+    private var sinkQueue: CMSimpleQueue?
+    private var videoDescription: CMFormatDescription?
+    private var bufferPool: CVPixelBufferPool?
+    private var bufferAuxAttributes: NSDictionary = [kCVPixelBufferPoolAllocationThresholdKey: 5]
+    private var readyToEnqueue = false
+    private var enqueuedOnce = false
+    private var clientsWantStream = false
+    private var feeding = false
+    private var pollTimer: Timer?
+    private var didObserveDevices = false
+
+    private init() {}
+
+    func startMonitoring() {
+        guard pollTimer == nil else { return }
+        allowScreenCaptureDevices()
+        registerDeviceNotifications()
+        connectToCamera()
+        pollTimer = Timer.scheduledTimer(withTimeInterval: 1.0, repeats: true) { [weak self] _ in
+            guard let self else { return }
+            Task { @MainActor in
+                self.pollStreamingDemand()
+            }
+        }
+        log.info("Camera feeder monitoring started")
+    }
+
+    func stopMonitoring() {
+        pollTimer?.invalidate()
+        pollTimer = nil
+        stopFeeding()
+        if let device = sinkDevice, let stream = sinkStream {
+            CMIODeviceStopStream(device, stream)
+        }
+        sinkQueue = nil
+        sinkStream = nil
+        sourceStream = nil
+        sinkDevice = nil
+    }
+
+    // MARK: - Demand
+
+    private func pollStreamingDemand() {
+        if sourceStream == nil || sinkStream == nil {
+            connectToCamera()
+        }
+        guard let sourceStream else { return }
+
+        // Nudge custom property; extension replies with sc=<source clients>.
+        setStreamingProperty(streamId: sourceStream, value: "ping")
+        let reply = getStreamingProperty(streamId: sourceStream) ?? ""
+        let want = reply.hasPrefix("sc=") && reply != "sc=0"
+        if want != clientsWantStream {
+            clientsWantStream = want
+            log.info("Camera clientsWantStream=\(want, privacy: .public) reply=\(reply, privacy: .public)")
+            if want {
+                startFeeding()
+            } else {
+                stopFeeding()
+            }
+        }
+    }
+
+    // MARK: - Sink connection
+
+    private func connectToCamera() {
+        guard let device = captureDevice(named: kCameraName) else {
+            return
+        }
+        guard let cmioId = cmioDevice(uid: device.uniqueID) else {
+            log.error("CMIO device id not found for \(device.uniqueID, privacy: .public)")
+            return
+        }
+        let streams = inputStreams(deviceId: cmioId)
+        guard streams.count >= 2 else {
+            log.error("Expected source+sink streams, got \(streams.count)")
+            return
+        }
+        sourceStream = streams[0]
+        sinkStream = streams[1]
+        sinkDevice = cmioId
+        initSink(deviceId: cmioId, sinkStream: streams[1])
+        log.info("Connected to camera sink (device=\(cmioId), streams=\(streams.count))")
+    }
+
+    private func initSink(deviceId: CMIODeviceID, sinkStream: CMIOStreamID) {
+        var format: CMFormatDescription?
+        CMVideoFormatDescriptionCreate(
+            allocator: kCFAllocatorDefault,
+            codecType: kCVPixelFormatType_32BGRA,
+            width: Int32(kFrameWidth),
+            height: Int32(kFrameHeight),
+            extensions: nil,
+            formatDescriptionOut: &format
+        )
+        videoDescription = format
+
+        let attrs: NSDictionary = [
+            kCVPixelBufferWidthKey: kFrameWidth,
+            kCVPixelBufferHeightKey: kFrameHeight,
+            kCVPixelBufferPixelFormatTypeKey: kCVPixelFormatType_32BGRA,
+            kCVPixelBufferIOSurfacePropertiesKey: [:] as NSDictionary
+        ]
+        var pool: CVPixelBufferPool?
+        CVPixelBufferPoolCreate(kCFAllocatorDefault, nil, attrs, &pool)
+        bufferPool = pool
+
+        let pointerQueue = UnsafeMutablePointer<Unmanaged<CMSimpleQueue>?>.allocate(capacity: 1)
+        defer { pointerQueue.deallocate() }
+        let refcon = Unmanaged.passUnretained(self).toOpaque()
+        let copyResult = CMIOStreamCopyBufferQueue(
+            sinkStream,
+            { _, _, refcon in
+                guard let refcon else { return }
+                let feeder = Unmanaged<DVLiveCameraFeeder>.fromOpaque(refcon).takeUnretainedValue()
+                Task { @MainActor in
+                    feeder.readyToEnqueue = true
+                }
+            },
+            refcon,
+            pointerQueue
+        )
+        guard copyResult == 0, let queue = pointerQueue.pointee?.takeUnretainedValue() else {
+            log.error("CMIOStreamCopyBufferQueue failed: \(copyResult)")
+            return
+        }
+        sinkQueue = queue
+        let startResult = CMIODeviceStartStream(deviceId, sinkStream)
+        if startResult != 0 {
+            log.error("CMIODeviceStartStream failed: \(startResult)")
+        }
+        readyToEnqueue = true
+    }
+
+    // MARK: - DV → sink
+
+    private func startFeeding() {
+        guard !feeding else { return }
+        if sinkQueue == nil {
+            connectToCamera()
+        }
+        guard sinkQueue != nil else { return }
+        feeding = true
+        let ok = pipeline.start(channel: 63) { [weak self] pixelBuffer, _, _ in
+            Task { @MainActor in
+                self?.enqueue(pixelBuffer)
+            }
+        }
+        if !ok {
+            feeding = false
+            log.error("DVLivePipeline start failed: \(self.pipeline.lastError ?? "unknown", privacy: .public)")
+        } else {
+            log.info("DV live feed to camera sink started")
+        }
+    }
+
+    private func stopFeeding() {
+        guard feeding else { return }
+        pipeline.stop()
+        feeding = false
+        enqueuedOnce = false
+        log.info("DV live feed stopped")
+    }
+
+    private func enqueue(_ source: CVPixelBuffer) {
+        guard let queue = sinkQueue, let videoDescription, let bufferPool else { return }
+        guard enqueuedOnce == false || readyToEnqueue else { return }
+        guard CMSimpleQueueGetCount(queue) < CMSimpleQueueGetCapacity(queue) else { return }
+
+        var pixelBuffer: CVPixelBuffer?
+        let poolErr = CVPixelBufferPoolCreatePixelBufferWithAuxAttributes(
+            kCFAllocatorDefault, bufferPool, bufferAuxAttributes, &pixelBuffer
+        )
+        guard poolErr == 0, let pixelBuffer else { return }
+
+        copyBGRA(from: source, to: pixelBuffer)
+
+        var timing = CMSampleTimingInfo(
+            duration: CMTime(value: 1, timescale: kFrameRate),
+            presentationTimeStamp: CMClockGetTime(CMClockGetHostTimeClock()),
+            decodeTimeStamp: .invalid
+        )
+        var sampleBuffer: CMSampleBuffer?
+        let err = CMSampleBufferCreateForImageBuffer(
+            allocator: kCFAllocatorDefault,
+            imageBuffer: pixelBuffer,
+            dataReady: true,
+            makeDataReadyCallback: nil,
+            refcon: nil,
+            formatDescription: videoDescription,
+            sampleTiming: &timing,
+            sampleBufferOut: &sampleBuffer
+        )
+        guard err == noErr, let sampleBuffer else { return }
+
+        readyToEnqueue = false
+        enqueuedOnce = true
+        let pointer = Unmanaged.passRetained(sampleBuffer).toOpaque()
+        CMSimpleQueueEnqueue(queue, element: pointer)
+    }
+
+    private func copyBGRA(from source: CVPixelBuffer, to dest: CVPixelBuffer) {
+        CVPixelBufferLockBaseAddress(source, .readOnly)
+        CVPixelBufferLockBaseAddress(dest, [])
+        defer {
+            CVPixelBufferUnlockBaseAddress(dest, [])
+            CVPixelBufferUnlockBaseAddress(source, .readOnly)
+        }
+        guard let src = CVPixelBufferGetBaseAddress(source),
+              let dst = CVPixelBufferGetBaseAddress(dest) else { return }
+        let height = min(CVPixelBufferGetHeight(source), CVPixelBufferGetHeight(dest))
+        let srcBPR = CVPixelBufferGetBytesPerRow(source)
+        let dstBPR = CVPixelBufferGetBytesPerRow(dest)
+        let row = min(srcBPR, dstBPR)
+        for y in 0..<height {
+            memcpy(dst.advanced(by: y * dstBPR), src.advanced(by: y * srcBPR), row)
+        }
+    }
+
+    // MARK: - CMIO helpers
+
+    private func allowScreenCaptureDevices() {
+        var prop = CMIOObjectPropertyAddress(
+            mSelector: CMIOObjectPropertySelector(kCMIOHardwarePropertyAllowScreenCaptureDevices),
+            mScope: CMIOObjectPropertyScope(kCMIOObjectPropertyScopeGlobal),
+            mElement: CMIOObjectPropertyElement(kCMIOObjectPropertyElementMain)
+        )
+        var allow: UInt32 = 1
+        CMIOObjectSetPropertyData(
+            CMIOObjectID(kCMIOObjectSystemObject),
+            &prop,
+            0,
+            nil,
+            UInt32(MemoryLayout<UInt32>.size),
+            &allow
+        )
+    }
+
+    private func registerDeviceNotifications() {
+        guard !didObserveDevices else { return }
+        didObserveDevices = true
+        NotificationCenter.default.addObserver(
+            forName: AVCaptureDevice.wasConnectedNotification,
+            object: nil,
+            queue: .main
+        ) { [weak self] _ in
+            guard let self else { return }
+            Task { @MainActor in
+                self.connectToCamera()
+            }
+        }
+    }
+
+    private func captureDevice(named name: String) -> AVCaptureDevice? {
+        let session = AVCaptureDevice.DiscoverySession(
+            deviceTypes: [.external],
+            mediaType: .video,
+            position: .unspecified
+        )
+        return session.devices.first { $0.localizedName == name }
+    }
+
+    private func cmioDevice(uid: String) -> CMIOObjectID? {
+        var dataSize: UInt32 = 0
+        var dataUsed: UInt32 = 0
+        var opa = CMIOObjectPropertyAddress(
+            CMIOObjectPropertySelector(kCMIOHardwarePropertyDevices),
+            .global,
+            .main
+        )
+        CMIOObjectGetPropertyDataSize(CMIOObjectID(kCMIOObjectSystemObject), &opa, 0, nil, &dataSize)
+        let count = Int(dataSize) / MemoryLayout<CMIOObjectID>.size
+        guard count > 0 else { return nil }
+        var devices = [CMIOObjectID](repeating: 0, count: count)
+        CMIOObjectGetPropertyData(
+            CMIOObjectID(kCMIOObjectSystemObject),
+            &opa,
+            0,
+            nil,
+            dataSize,
+            &dataUsed,
+            &devices
+        )
+        for id in devices {
+            opa.mSelector = CMIOObjectPropertySelector(kCMIODevicePropertyDeviceUID)
+            CMIOObjectGetPropertyDataSize(id, &opa, 0, nil, &dataSize)
+            var name: CFString = "" as NSString
+            CMIOObjectGetPropertyData(id, &opa, 0, nil, dataSize, &dataUsed, &name)
+            if String(name) == uid {
+                return id
+            }
+        }
+        return nil
+    }
+
+    private func inputStreams(deviceId: CMIODeviceID) -> [CMIOStreamID] {
+        var dataSize: UInt32 = 0
+        var dataUsed: UInt32 = 0
+        var opa = CMIOObjectPropertyAddress(
+            CMIOObjectPropertySelector(kCMIODevicePropertyStreams),
+            .global,
+            .main
+        )
+        CMIOObjectGetPropertyDataSize(deviceId, &opa, 0, nil, &dataSize)
+        let count = Int(dataSize) / MemoryLayout<CMIOStreamID>.size
+        guard count > 0 else { return [] }
+        var streams = [CMIOStreamID](repeating: 0, count: count)
+        CMIOObjectGetPropertyData(deviceId, &opa, 0, nil, dataSize, &dataUsed, &streams)
+        return streams
+    }
+
+    private func getStreamingProperty(streamId: CMIOStreamID) -> String? {
+        var address = CMIOObjectPropertyAddress(kStreamingProperty, .global, .main)
+        guard CMIOObjectHasProperty(streamId, &address) else { return nil }
+        var dataSize: UInt32 = 0
+        var dataUsed: UInt32 = 0
+        CMIOObjectGetPropertyDataSize(streamId, &address, 0, nil, &dataSize)
+        var name: CFString = "" as NSString
+        CMIOObjectGetPropertyData(streamId, &address, 0, nil, dataSize, &dataUsed, &name)
+        return name as String
+    }
+
+    private func setStreamingProperty(streamId: CMIOStreamID, value: String) {
+        var address = CMIOObjectPropertyAddress(kStreamingProperty, .global, .main)
+        guard CMIOObjectHasProperty(streamId, &address) else { return }
+        var settable = DarwinBoolean(false)
+        CMIOObjectIsPropertySettable(streamId, &address, &settable)
+        guard settable.boolValue else { return }
+        var dataSize: UInt32 = 0
+        CMIOObjectGetPropertyDataSize(streamId, &address, 0, nil, &dataSize)
+        var newName: CFString = value as NSString
+        CMIOObjectSetPropertyData(streamId, &address, 0, nil, dataSize, &newName)
+    }
+}
+
+// MARK: - CoreMediaIO address helpers
+
+private extension CMIOObjectPropertyAddress {
+    init(_ selector: CMIOObjectPropertySelector,
+         _ scope: CMIOObjectPropertyScope,
+         _ element: CMIOObjectPropertyElement) {
+        self.init(mSelector: selector, mScope: scope, mElement: element)
+    }
+}
+
+private extension CMIOObjectPropertyScope {
+    static let global = CMIOObjectPropertyScope(kCMIOObjectPropertyScopeGlobal)
+}
+
+private extension CMIOObjectPropertyElement {
+    static let main = CMIOObjectPropertyElement(kCMIOObjectPropertyElementMain)
+}
+
+private enum ASFWFourCC {
+    static func code(_ value: String) -> FourCharCode {
+        var code: FourCharCode = 0
+        if value.utf8.count == 4 {
+            for byte in value.utf8 {
+                code = (code << 8) + FourCharCode(byte)
+            }
+        } else {
+            code = 0x3F3F3F3F
+        }
+        return code
+    }
+}
