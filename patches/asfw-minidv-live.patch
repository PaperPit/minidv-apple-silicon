diff --git a/ASFWCameraInstall/main.swift b/ASFWCameraInstall/main.swift
new file mode 100644
index 0000000..3c1f4ab
--- /dev/null
+++ b/ASFWCameraInstall/main.swift
@@ -0,0 +1,88 @@
+import AppKit
+import Foundation
+import SystemExtensions
+
+@main
+enum ASFWCameraInstallMain {
+    static func main() {
+        let app = NSApplication.shared
+        app.setActivationPolicy(.accessory)
+        InstallRunner.shared.run()
+        app.run()
+    }
+}
+
+final class InstallRunner: NSObject, OSSystemExtensionRequestDelegate {
+    static let shared = InstallRunner()
+    private let cameraID = "net.mrmidi.ASFW.ASFWCamera"
+    private let logURL = URL(fileURLWithPath: NSHomeDirectory())
+        .appendingPathComponent("Library/Logs/ASFW-install.log")
+
+    func run() {
+        append("ASFWCameraInstall starting…")
+        logBundleScan()
+        let request = OSSystemExtensionRequest.activationRequest(
+            forExtensionWithIdentifier: cameraID,
+            queue: .main
+        )
+        request.delegate = self
+        OSSystemExtensionManager.shared.submitRequest(request)
+    }
+
+    func request(
+        _ request: OSSystemExtensionRequest,
+        actionForReplacingExtension existing: OSSystemExtensionProperties,
+        withExtension replacement: OSSystemExtensionProperties
+    ) -> OSSystemExtensionRequest.ReplacementAction {
+        let msg = "Replacing \(existing.bundleIdentifier) \(existing.bundleVersion) → \(replacement.bundleVersion)"
+        append(msg)
+        fputs("[ASFWCameraInstall] \(msg)\n", stderr)
+        return .replace
+    }
+
+    func requestNeedsUserApproval(_ request: OSSystemExtensionRequest) {
+        append("NEEDS USER APPROVAL for \(cameraID)")
+        fputs("[ASFWCameraInstall] Approve camera in System Settings…\n", stderr)
+    }
+
+    func request(_ request: OSSystemExtensionRequest, didFinishWithResult result: OSSystemExtensionRequest.Result) {
+        let msg = "Activation of \(cameraID) finished with result: \(result.rawValue)"
+        append(msg)
+        fputs("[ASFWCameraInstall] \(msg)\n", stderr)
+        DispatchQueue.main.asyncAfter(deadline: .now() + 0.5) {
+            NSApp.terminate(nil)
+        }
+    }
+
+    func request(_ request: OSSystemExtensionRequest, didFailWithError error: Error) {
+        let msg = "FAIL \(cameraID): \(error.localizedDescription)"
+        append(msg)
+        fputs("[ASFWCameraInstall] \(msg)\n", stderr)
+        DispatchQueue.main.asyncAfter(deadline: .now() + 0.5) {
+            NSApp.terminate(nil)
+        }
+    }
+
+    private func logBundleScan() {
+        let dir = Bundle.main.bundleURL.appendingPathComponent("Contents/Library/SystemExtensions")
+        append("SystemExtensions dir: \(dir.path)")
+        if let entries = try? FileManager.default.contentsOfDirectory(at: dir, includingPropertiesForKeys: nil) {
+            for url in entries where url.pathExtension == "systemextension" {
+                append("Found: \(url.lastPathComponent)")
+            }
+        }
+    }
+
+    private func append(_ line: String) {
+        let stamped = "\(Date()): \(line)\n"
+        guard let data = stamped.data(using: .utf8) else { return }
+        if FileManager.default.fileExists(atPath: logURL.path),
+           let handle = try? FileHandle(forWritingTo: logURL) {
+            defer { try? handle.close() }
+            _ = try? handle.seekToEnd()
+            _ = try? handle.write(contentsOf: data)
+        } else {
+            try? data.write(to: logURL)
+        }
+    }
+}
