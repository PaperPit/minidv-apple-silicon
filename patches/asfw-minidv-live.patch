diff --git a/scripts/minidv-live/MiniDVLive b/scripts/minidv-live/MiniDVLive
new file mode 100755
index 0000000..a0943cd
--- /dev/null
+++ b/scripts/minidv-live/MiniDVLive
@@ -0,0 +1,123 @@
+#!/bin/bash
+#
+#  MiniDV Live — один клик: камера Sony DCR-PC115E (видео через Syphon,
+#  звук через BlackHole) + OBS с уже настроенными источниками.
+#
+#  Что делает:
+#    1. проверяет драйвер FireWire ASFW и наличие BlackHole;
+#    2. останавливает прошлый живой захват (иначе два процесса дерутся за
+#       одно кольцо драйвера) и запускает новый;
+#    3. открывает OBS, если он закрыт;
+#    4. через obs-websocket добавляет в текущую сцену источники
+#       «Sony DCR-PC115E» (Syphon) и «BlackHole 2ch», если их ещё нет.
+#
+#  Лог: ~/Library/Logs/MiniDVLive.log
+#
+set -u
+
+LOG="$HOME/Library/Logs/MiniDVLive.log"
+ASFW="/Applications/ASFW.app"
+ASFW_BIN="$ASFW/Contents/MacOS/ASFW"
+HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
+RES="$(cd "$HERE/../Resources" && pwd)"
+OBS_WS_CONFIG="$HOME/Library/Application Support/obs-studio/plugin_config/obs-websocket/config.json"
+OBS_WS_PORT=4455
+
+log() { printf '%s %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$*" >>"$LOG"; }
+# MINIDV_NO_DIALOG=1 — только лог, без окон (удобно для отладки из терминала).
+notify() {
+  [ "${MINIDV_NO_DIALOG:-0}" = "1" ] && return 0
+  /usr/bin/osascript -e "display notification \"$1\" with title \"MiniDV Live\"" >/dev/null 2>&1 || true
+}
+fail() {
+  log "ОШИБКА: $*"
+  [ "${MINIDV_NO_DIALOG:-0}" = "1" ] || /usr/bin/osascript -e "display dialog \"$*\" buttons {\"ОК\"} default button 1 with title \"MiniDV Live\" with icon caution" >/dev/null 2>&1 || true
+  exit 1
+}
+
+mkdir -p "$(dirname "$LOG")"
+log "--- запуск (аргументы: $*) ---"
+
+[ -x "$ASFW_BIN" ] || fail "Не найден $ASFW — установите ASFW.app в /Applications."
+
+# 1. Драйвер FireWire
+if ! /usr/sbin/ioreg -p IOService -w0 2>/dev/null | /usr/bin/grep -q "ASFWDriver"; then
+  fail "Драйвер ASFW не загружен. Проверьте: systemextensionsctl list (должно быть net.mrmidi.ASFW.ASFWDriver [activated enabled])."
+fi
+
+# 2. Приёмник звука
+AUDIO=1
+if ! "$ASFW_BIN" --list-audio-devices 2>/dev/null | /usr/bin/grep -q "BlackHole"; then
+  AUDIO=0
+  log "BlackHole не найден — запускаю только видео (звук в OBS не попадёт)"
+fi
+
+# 3. WebSocket-сервер OBS (нужен, чтобы добавлять источники)
+if [ -f "$OBS_WS_CONFIG" ]; then
+  if /usr/bin/grep -q '"server_enabled": false' "$OBS_WS_CONFIG"; then
+    /bin/cp -n "$OBS_WS_CONFIG" "$OBS_WS_CONFIG.bak-minidv" 2>/dev/null || true
+    /usr/bin/sed -i '' 's/"server_enabled": false/"server_enabled": true/' "$OBS_WS_CONFIG" 2>/dev/null \
+      && log "включил WebSocket-сервер OBS (если OBS был открыт — потребуется перезапустить его один раз)"
+  fi
+else
+  log "нет конфига obs-websocket — источники придётся добавлять вручную"
+fi
+
+# 4. Прошлый живой захват — вниз
+if /usr/bin/pkill -f -- "--syphon" 2>/dev/null; then
+  log "остановлен прошлый живой захват"
+  sleep 2
+fi
+
+# 5. Камера
+if [ "$AUDIO" = "1" ]; then
+  /usr/bin/open -n "$ASFW" --args --syphon --audio-device "BlackHole 2ch"
+else
+  /usr/bin/open -n "$ASFW" --args --syphon --no-audio
+fi
+log "ASFW запущен в живом режиме (звук: $([ "$AUDIO" = 1 ] && echo BlackHole || echo выключен))"
+
+sleep 3
+if ! /usr/bin/pgrep -f -- "--syphon" >/dev/null; then
+  fail "Камера не поднялась: процесс ASFW --syphon не найден. Смотрите $LOG и ~/Library/Logs/ASFW-install.log"
+fi
+
+# 6. OBS
+if /usr/bin/pgrep -x OBS >/dev/null; then
+  log "OBS уже запущен"
+else
+  log "запускаю OBS"
+  /usr/bin/open -a OBS >/dev/null 2>&1 || fail "OBS не найден в /Applications."
+fi
+
+# ждём порт WebSocket (не дольше 20 с)
+for _ in $(seq 1 40); do
+  if (exec 3<>"/dev/tcp/127.0.0.1/$OBS_WS_PORT") 2>/dev/null; then
+    exec 3<&- 2>/dev/null || true
+    break
+  fi
+  sleep 0.5
+done
+
+# 7. Источники в OBS
+find_node() {
+  for candidate in "$(command -v node 2>/dev/null)" "$HOME/.local/bin/node" /opt/homebrew/bin/node /usr/local/bin/node; do
+    if [ -n "$candidate" ] && [ -x "$candidate" ]; then echo "$candidate"; return 0; fi
+  done
+  return 1
+}
+
+NODE="$(find_node || true)"
+if [ -z "$NODE" ]; then
+  log "node не найден — источники в OBS не настроены автоматически"
+  notify "Камера и звук запущены. Источники в OBS добавьте вручную."
+elif "$NODE" "$RES/obs-sources.js" >>"$LOG" 2>&1; then
+  log "источники OBS готовы"
+  notify "Камера и звук запущены, OBS настроен"
+else
+  log "не удалось настроить источники автоматически (подробности выше в логе)"
+  notify "Камера и звук запущены. Источники в OBS добавьте вручную."
+fi
+
+log "--- готово ---"
+exit 0
diff --git a/scripts/minidv-live/install.sh b/scripts/minidv-live/install.sh
new file mode 100755
index 0000000..1a17fe7
--- /dev/null
+++ b/scripts/minidv-live/install.sh
@@ -0,0 +1,103 @@
+#!/bin/bash
+#
+#  install.sh — собирает ярлык «MiniDV Live.app» и ставит его в /Applications.
+#
+#  Сам ярлык — обычный bash-скрипт плюс помощник на node (obs-sources.js).
+#  Иконка рисуется здесь же, внешних зависимостей нет (python3, sips, iconutil
+#  есть в системе).
+#
+#  Запуск:  ./install.sh
+#
+set -euo pipefail
+
+HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
+TARGET="/Applications/MiniDV Live.app"
+STAGE="$(mktemp -d)"
+trap 'rm -rf "$STAGE"' EXIT
+
+APP="$STAGE/MiniDV Live.app"
+mkdir -p "$APP/Contents/MacOS" "$APP/Contents/Resources"
+
+cat > "$APP/Contents/Info.plist" <<'PLIST'
+<?xml version="1.0" encoding="UTF-8"?>
+<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
+<plist version="1.0">
+<dict>
+	<key>CFBundleName</key><string>MiniDV Live</string>
+	<key>CFBundleDisplayName</key><string>MiniDV Live</string>
+	<key>CFBundleIdentifier</key><string>local.minidv.live</string>
+	<key>CFBundleExecutable</key><string>MiniDVLive</string>
+	<key>CFBundleIconFile</key><string>AppIcon</string>
+	<key>CFBundlePackageType</key><string>APPL</string>
+	<key>CFBundleShortVersionString</key><string>1.0</string>
+	<key>CFBundleVersion</key><string>1</string>
+	<key>CFBundleInfoDictionaryVersion</key><string>6.0</string>
+	<key>LSMinimumSystemVersion</key><string>13.0</string>
+	<key>LSUIElement</key><true/>
+	<key>NSHighResolutionCapable</key><true/>
+	<key>NSHumanReadableCopyright</key><string>Локальный ярлык для ASFW + OBS</string>
+</dict>
+</plist>
+PLIST
+
+install -m 755 "$HERE/MiniDVLive" "$APP/Contents/MacOS/MiniDVLive"
+install -m 644 "$HERE/obs-sources.js" "$APP/Contents/Resources/obs-sources.js"
+
+# --- иконка: камера с объективом и зелёной точкой записи ---
+python3 - "$STAGE/icon1024.png" <<'PY'
+import struct, sys, zlib
+
+W = H = 1024
+BG, BODY, RING, LENS, REC = (21, 26, 34), (43, 52, 68), (106, 168, 255), (14, 18, 24), (78, 201, 138)
+img = bytearray(BG * (W * H))
+
+def put(x, y, c):
+    if 0 <= x < W and 0 <= y < H:
+        i = (y * W + x) * 3
+        img[i:i + 3] = bytes(c)
+
+def disc(cx, cy, r, c):
+    for y in range(cy - r, cy + r + 1):
+        dx = int((r * r - (y - cy) ** 2) ** 0.5)
+        for x in range(cx - dx, cx + dx + 1):
+            put(x, y, c)
+
+x0, y0, x1, y1, rad = 112, 322, 912, 702, 56
+for y in range(y0, y1):
+    for x in range(x0, x1):
+        dx = max(x0 + rad - x, x - (x1 - rad), 0)
+        dy = max(y0 + rad - y, y - (y1 - rad), 0)
+        if dx * dx + dy * dy <= rad * rad:
+            put(x, y, BODY)
+disc(512, 512, 300, RING)
+disc(512, 512, 284, BODY)
+disc(512, 512, 150, LENS)
+disc(790, 250, 46, REC)
+
+raw = b''.join(b'\x00' + bytes(img[y * W * 3:(y + 1) * W * 3]) for y in range(H))
+
+def chunk(tag, data):
+    return struct.pack('>I', len(data)) + tag + data + struct.pack('>I', zlib.crc32(tag + data) & 0xffffffff)
+
+png = b'\x89PNG\r\n\x1a\n'
+png += chunk(b'IHDR', struct.pack('>IIBBBBB', W, H, 8, 2, 0, 0, 0))
+png += chunk(b'IDAT', zlib.compress(raw, 9))
+png += chunk(b'IEND', b'')
+open(sys.argv[1], 'wb').write(png)
+PY
+
+ICONSET="$STAGE/icon.iconset"
+mkdir -p "$ICONSET"
+for size in 16 32 128 256 512; do
+  sips -z "$size" "$size" "$STAGE/icon1024.png" --out "$ICONSET/icon_${size}x${size}.png" >/dev/null
+  double=$((size * 2))
+  sips -z "$double" "$double" "$STAGE/icon1024.png" --out "$ICONSET/icon_${size}x${size}@2x.png" >/dev/null
+done
+iconutil -c icns "$ICONSET" -o "$APP/Contents/Resources/AppIcon.icns"
+
+rm -rf "$TARGET"
+cp -R "$APP" "$TARGET"
+chmod -R u+rwX,go+rX "$TARGET"
+
+echo "Установлено: $TARGET"
+echo "Запуск: двойной клик в Finder, из Launchpad или: open -a 'MiniDV Live'"
diff --git a/scripts/minidv-live/obs-sources.js b/scripts/minidv-live/obs-sources.js
new file mode 100644
index 0000000..c42bee4
--- /dev/null
+++ b/scripts/minidv-live/obs-sources.js
@@ -0,0 +1,275 @@
+#!/usr/bin/env node
+//
+//  obs-sources.js — приводит текущую сцену OBS к рабочему виду:
+//  добавляет Syphon-источник с камеры и аудиовход BlackHole, вписывает видео в канву.
+//  Идемпотентно: если источники уже есть, они только перенастраиваются.
+//
+//  Работает через obs-websocket (OBS 28+, порт 4455). Пароль берётся из конфига OBS.
+//
+
+const fs = require('fs');
+const os = require('os');
+const path = require('path');
+const crypto = require('crypto');
+
+const CONFIG = path.join(
+  os.homedir(),
+  'Library/Application Support/obs-studio/plugin_config/obs-websocket/config.json'
+);
+const VIDEO_NAME = 'Sony DCR-PC115E';
+const AUDIO_NAME = 'BlackHole 2ch';
+const SYPHON_SERVER = 'Sony DCR-PC115E';
+const DEVICE_HINT = 'BlackHole';
+const TIMEOUT_MS = 15000;
+
+const log = (...args) => console.log('[obs-sources]', ...args);
+
+let config;
+try {
+  config = JSON.parse(fs.readFileSync(CONFIG, 'utf8'));
+} catch (error) {
+  log('не читается конфиг obs-websocket:', error.message);
+  process.exit(2);
+}
+if (!config.server_enabled) {
+  log('WebSocket-сервер OBS выключен (server_enabled=false)');
+  process.exit(3);
+}
+
+const port = config.server_port || 4455;
+const password = config.server_password || '';
+
+const pending = new Map();
+let counter = 1;
+let finished = false;
+
+const socket = new WebSocket(`ws://127.0.0.1:${port}`);
+const timer = setTimeout(() => {
+  log('таймаут: OBS не ответил');
+  process.exit(4);
+}, TIMEOUT_MS);
+
+function request(requestType, requestData = {}) {
+  const requestId = String(counter++);
+  return new Promise((resolve, reject) => {
+    pending.set(requestId, { resolve, reject });
+    socket.send(JSON.stringify({ op: 6, d: { requestType, requestId, requestData } }));
+  });
+}
+
+function authString(challenge, salt) {
+  const secret = crypto.createHash('sha256').update(password + salt).digest('base64');
+  return crypto.createHash('sha256').update(secret + challenge).digest('base64');
+}
+
+socket.onerror = () => {
+  log('нет связи с obs-websocket (сервер выключен или OBS не запущен)');
+  clearTimeout(timer);
+  process.exit(5);
+};
+
+socket.onmessage = async (event) => {
+  const message = JSON.parse(event.data);
+
+  if (message.op === 0) { // Hello
+    const payload = { rpcVersion: 1, eventSubscriptions: 0 };
+    if (message.d.authentication) {
+      payload.authentication = authString(message.d.authentication.challenge, message.d.authentication.salt);
+    }
+    socket.send(JSON.stringify({ op: 1, d: payload }));
+    return;
+  }
+
+  if (message.op === 2) { // Identified
+    try {
+      await syncScene();
+      clearTimeout(timer);
+      finished = true;
+      socket.close();
+      process.exit(0);
+    } catch (error) {
+      log('ОШИБКА:', error.message);
+      clearTimeout(timer);
+      process.exit(6);
+    }
+    return;
+  }
+
+  if (message.op === 7) { // RequestResponse
+    const { requestId, requestStatus, responseData } = message.d;
+    const entry = pending.get(requestId);
+    if (!entry) return;
+    pending.delete(requestId);
+    if (requestStatus && requestStatus.result === false) {
+      entry.reject(new Error(`${requestStatus.code}: ${requestStatus.comment}`));
+    } else {
+      entry.resolve(responseData || {});
+    }
+  }
+};
+
+socket.onclose = () => {
+  if (!finished) {
+    log('соединение закрыто до завершения');
+    process.exit(7);
+  }
+};
+
+async function inputList() {
+  const data = await request('GetInputList');
+  return data.inputs || [];
+}
+
+async function createInput(name, kind, sceneName, settings) {
+  const payload = {
+    inputName: name,
+    inputKind: kind,
+    sceneName,
+    inputSettings: settings,
+    sceneItemEnabled: true,
+  };
+  try {
+    await request('CreateInput', payload);
+  } catch (error) {
+    // Старые сборки obs-websocket не знают sceneItemEnabled.
+    delete payload.sceneItemEnabled;
+    await request('CreateInput', payload);
+  }
+}
+
+async function syncScene() {
+  const scenes = await request('GetSceneList');
+  const sceneName = scenes.currentProgramSceneName
+    || (scenes.scenes && scenes.scenes[0] && scenes.scenes[0].sceneName);
+  if (!sceneName) throw new Error('в OBS нет ни одной сцены');
+  log('текущая сцена:', sceneName);
+
+  let inputs = await inputList();
+
+  // --- Видео: Syphon-клиент -------------------------------------------------
+  if (!inputs.some((i) => i.inputName === VIDEO_NAME)) {
+    await createInput(VIDEO_NAME, 'syphon-input', sceneName, {});
+    log('создан источник видео:', VIDEO_NAME);
+    inputs = await inputList();
+  } else {
+    log('источник видео уже есть:', VIDEO_NAME);
+  }
+
+  // Syphon-сервер выбирается по uuid, а когда uuid сменился (новый запуск ASFW) —
+  // по паре name+app_name. Прописываем все три поля, иначе источник остаётся чёрным.
+  // После перезапуска ASFW каталог Syphon какое-то время держит и старое
+  // объявление сервера, поэтому ждём и берём самое свежее совпадение.
+  let server = null;
+  for (let attempt = 0; attempt < 10; attempt += 1) {
+    const servers = await request('GetInputPropertiesListPropertyItems', {
+      inputName: VIDEO_NAME,
+      propertyName: 'uuid',
+    });
+    const matches = (servers.propertyItems || []).filter(
+      (p) => (p.itemName || '').includes(SYPHON_SERVER) && p.itemValue
+    );
+    if (matches.length) {
+      server = matches[matches.length - 1];
+      if (matches.length > 1) {
+        log(`видео: видно ${matches.length} сервера с этим именем — беру самый свежий`);
+      }
+      break;
+    }
+    await new Promise((resolve) => setTimeout(resolve, 1000));
+  }
+  if (!server) {
+    log(`Syphon-сервер «${SYPHON_SERVER}» не найден — живой режим ASFW не запущен?`);
+  } else {
+    const parsed = /^\[(.+?)\]\s*(.*)$/.exec(server.itemName);
+    const appName = parsed ? parsed[1] : 'ASFW';
+    const serverName = parsed ? parsed[2] : SYPHON_SERVER;
+    const current = await request('GetInputSettings', { inputName: VIDEO_NAME });
+    const settings = current.inputSettings || {};
+    if (settings.uuid !== server.itemValue || settings.name !== serverName || settings.app_name !== appName) {
+      await request('SetInputSettings', {
+        inputName: VIDEO_NAME,
+        inputSettings: { uuid: server.itemValue, name: serverName, app_name: appName },
+        overlay: true,
+      });
+      log(`видео: сервер «${appName} / ${serverName}» выбран явно`);
+    } else {
+      log('видео: сервер уже выбран');
+    }
+  }
+
+  const video = await request('GetVideoSettings');
+  const items = await request('GetSceneItemList', { sceneName });
+  const item = (items.sceneItems || []).find((i) => i.sourceName === VIDEO_NAME);
+  if (item) {
+    await request('SetSceneItemTransform', {
+      sceneName,
+      sceneItemId: item.sceneItemId,
+      sceneItemTransform: {
+        boundsType: 'OBS_BOUNDS_SCALE_INNER',
+        boundsAlignment: 0,
+        boundsWidth: video.baseWidth || 1920,
+        boundsHeight: video.baseHeight || 1080,
+        positionX: 0,
+        positionY: 0,
+        alignment: 5,
+      },
+    });
+    log(`видео: вписано в канву ${video.baseWidth}x${video.baseHeight}`);
+  }
+
+  // --- Звук: вход BlackHole -------------------------------------------------
+  inputs = await inputList();
+  if (!inputs.some((i) => i.inputName === AUDIO_NAME)) {
+    await createInput(AUDIO_NAME, 'coreaudio_input_capture', sceneName, {});
+    log('создан источник звука:', AUDIO_NAME);
+    inputs = await inputList();
+  } else {
+    log('источник звука уже есть:', AUDIO_NAME);
+  }
+
+  const audioSettings = await request('GetInputSettings', { inputName: AUDIO_NAME });
+  const currentDevice = (audioSettings.inputSettings || {}).device_id;
+  if (typeof currentDevice === 'string' && currentDevice.toLowerCase().includes(DEVICE_HINT.toLowerCase())) {
+    log('звук: устройство уже выбрано —', currentDevice);
+  } else {
+    const property = await request('GetInputPropertiesListPropertyItems', {
+      inputName: AUDIO_NAME,
+      propertyName: 'device_id',
+    });
+    const device = (property.propertyItems || []).find(
+      (p) => (p.itemName || '').toLowerCase().includes(DEVICE_HINT.toLowerCase())
+    );
+    if (device) {
+      await request('SetInputSettings', {
+        inputName: AUDIO_NAME,
+        inputSettings: { device_id: device.itemValue },
+        overlay: true,
+      });
+      log(`звук: устройство = ${device.itemName} (${device.itemValue})`);
+    } else {
+      log('звук: в списке устройств OBS нет BlackHole — выберите вручную');
+    }
+  }
+
+  // --- Виртуальная камера ---------------------------------------------------
+  // Расширение OBS Virtual Camera видно в списке устройств всегда, даже когда
+  // OBS закрыт, но кадры идут только при включённом выходе. Поэтому включаем.
+  if (process.env.MINIDV_NO_VIRTUALS === '1') {
+    log('виртуальная камера: пропущена (MINIDV_NO_VIRTUALS=1)');
+  } else {
+    const status = await request('GetVirtualCamStatus').catch(() => null);
+    if (status && status.outputActive) {
+      log('виртуальная камера уже включена');
+    } else {
+      try {
+        await request('StartVirtualCam');
+        log('виртуальная камера включена (OBS Virtual Camera)');
+      } catch (error) {
+        log('виртуальную камеру включить не удалось:', error.message);
+      }
+    }
+  }
+
+  const final = await inputList();
+  log('источники сцены: ' + final.map((i) => `${i.inputName} [${i.inputKind}]`).join(', '));
+}
diff --git a/scripts/run-camera-extension.sh b/scripts/run-camera-extension.sh
new file mode 100755
index 0000000..466580d
--- /dev/null
+++ b/scripts/run-camera-extension.sh
@@ -0,0 +1,62 @@
+#!/usr/bin/env bash
+# Launch Development-signed ASFWCamera from the app bundle via LaunchAgent.
+# Used when Personal Team cannot activate a Development-signed CMIO extension
+# through OSSystemExtensionRequest (no system-extension.install profile).
+set -Eeuo pipefail
+
+LABEL=net.mrmidi.ASFW.ASFWCamera
+TEAM_ID=989597PNQ7
+MACH="${TEAM_ID}.net.mrmidi.ASFW.ASFWCamera"
+APP="${1:-/Applications/ASFW.app}"
+EXT="${APP}/Contents/Library/SystemExtensions/net.mrmidi.ASFW.ASFWCamera.systemextension"
+BIN="${EXT}/Contents/MacOS/net.mrmidi.ASFW.ASFWCamera"
+AGENT_DST="$HOME/Library/LaunchAgents/${LABEL}.plist"
+
+[[ -x "${BIN}" ]] || { echo "Camera binary not found: ${BIN}"; exit 1; }
+
+# Must be Development-signed with matching Team ID.
+TEAM="$(codesign -dv --verbose=2 "${EXT}" 2>&1 | awk -F= '/TeamIdentifier=/{print $2; exit}')"
+if [[ "${TEAM}" != "${TEAM_ID}" ]]; then
+  echo "Camera TeamIdentifier='${TEAM}' (want ${TEAM_ID}). Run ./sign.sh first."
+  exit 1
+fi
+
+mkdir -p "$HOME/Library/LaunchAgents"
+cat > "${AGENT_DST}" <<PLIST
+<?xml version="1.0" encoding="UTF-8"?>
+<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
+<plist version="1.0">
+<dict>
+	<key>Label</key>
+	<string>${LABEL}</string>
+	<key>ProgramArguments</key>
+	<array>
+		<string>${BIN}</string>
+	</array>
+	<key>MachServices</key>
+	<dict>
+		<key>${MACH}</key>
+		<true/>
+	</dict>
+	<key>RunAtLoad</key>
+	<true/>
+	<key>KeepAlive</key>
+	<true/>
+	<key>StandardOutPath</key>
+	<string>/tmp/asfw-camera.log</string>
+	<key>StandardErrorPath</key>
+	<string>/tmp/asfw-camera.err</string>
+</dict>
+</plist>
+PLIST
+
+launchctl bootout "gui/$(id -u)/${LABEL}" 2>/dev/null || true
+launchctl bootstrap "gui/$(id -u)" "${AGENT_DST}"
+launchctl kickstart -k "gui/$(id -u)/${LABEL}" 2>/dev/null || true
+sleep 1
+echo "--- agent ---"
+launchctl print "gui/$(id -u)/${LABEL}" 2>/dev/null | head -25 || true
+echo "--- stderr ---"
+tail -20 /tmp/asfw-camera.err 2>/dev/null || true
+echo "Camera agent started from ${BIN}"
+echo "Keep ASFW.app running, then open Photo Booth → Sony DCR-PC115E"
