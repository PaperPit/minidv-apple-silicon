diff --git a/ASFW/ASFWApp.swift b/ASFW/ASFWApp.swift
index 236b0b5..21a98bb 100644
--- a/ASFW/ASFWApp.swift
+++ b/ASFW/ASFWApp.swift
@@ -5,9 +5,13 @@
 //  Created by Alexander Shabelnikov on 21.09.2025.
 //
 
+import AppKit
 import SwiftUI
+
 @main
 struct ASFWApp: App {
+    @NSApplicationDelegateAdaptor(ASFWAppDelegate.self) var appDelegate
+
     var body: some Scene {
         WindowGroup {
             ModernContentView()
@@ -15,3 +19,136 @@ struct ASFWApp: App {
         .defaultSize(width: 1000, height: 700)
     }
 }
+
+final class ASFWAppDelegate: NSObject, NSApplicationDelegate {
+    func applicationDidFinishLaunching(_ notification: Notification) {
+        InstallBootstrap.runIfRequested()
+
+        // Headless-проверки звука: --list-audio-devices, --audio-selftest,
+        // --dv-audio-selftest, --audio-render-selftest.
+        if let code = ASFWCommandLine.captureAudioSettingsAndRunHeadless() {
+            exit(code)
+        }
+
+        if !CommandLine.arguments.contains("--install-extensions"),
+           !CommandLine.arguments.contains("--install-camera") {
+            logAudioDestination()
+            DVLiveCameraFeeder.shared.startMonitoring()
+            if ProcessInfo.processInfo.arguments.contains("--syphon") {
+                DVSyphonRunner.shared.start()
+            }
+        }
+    }
+
+    func applicationWillTerminate(_ notification: Notification) {
+        DVLiveCameraFeeder.shared.stopMonitoring()
+        DVSyphonRunner.shared.stop()
+    }
+
+    /// Куда пойдёт звук с камеры. BlackHole ставится отдельно, поэтому о
+    /// подмене на системный выход лучше сказать вслух.
+    private func logAudioDestination() {
+        guard DVAudioPlayer.isEnabled else {
+            fputs("[ASFW] звук с камеры выключен (--no-audio)\n", stderr)
+            return
+        }
+        let query = DVAudioPlayer.preferredDeviceQuery ?? "default"
+        guard let device = CoreAudioDevices.resolve(query: query) else { return }
+        let matched = query.lowercased() == "default"
+            || device.name.lowercased().contains(query.lowercased())
+            || device.uid.lowercased().contains(query.lowercased())
+        if matched {
+            fputs("[ASFW] звук с камеры → «\(device.name)»\n", stderr)
+        } else {
+            fputs("[ASFW] звук: «\(query)» не найдено, играю в «\(device.name)». "
+                  + "Виртуальный микрофон: brew install --cask blackhole-2ch\n", stderr)
+        }
+    }
+}
+
+/// Аргументы командной строки: настройки звука и headless-проверки.
+enum ASFWCommandLine {
+    static let args = CommandLine.arguments
+
+    static func has(_ flag: String) -> Bool { args.contains(flag) }
+
+    static func value(after flag: String) -> String? {
+        guard let index = args.firstIndex(of: flag), index + 1 < args.count else { return nil }
+        let next = args[index + 1]
+        return next.hasPrefix("--") ? nil : next
+    }
+
+    /// Ставит настройки звука для живого режима и, если запрошена проверка,
+    /// возвращает код выхода (nil — проверок нет).
+    static func captureAudioSettingsAndRunHeadless() -> Int32? {
+        if has("--no-audio") {
+            DVAudioPlayer.isEnabled = false
+        }
+        if let explicit = value(after: "--audio-device") {
+            DVAudioPlayer.preferredDeviceQuery = explicit
+        }
+        return DVLiveDiagnostics.runHeadless(arguments: args)
+    }
+}
+
+/// Headless activation: `/Applications/ASFW.app/Contents/MacOS/ASFW --install-extensions`
+enum InstallBootstrap {
+    private static var started = false
+    private static let logURL = URL(fileURLWithPath: NSHomeDirectory())
+        .appendingPathComponent("Library/Logs/ASFW-install.log")
+
+    static func runIfRequested() {
+        guard !started else { return }
+        started = true
+
+        appendLog("launch args: \(CommandLine.arguments)")
+        let installAll = CommandLine.arguments.contains("--install-extensions")
+        let installCamera = CommandLine.arguments.contains("--install-camera")
+        guard installAll || installCamera else {
+            appendLog("no --install-extensions / --install-camera flag; skipping")
+            return
+        }
+
+        if installCamera && !installAll {
+            appendLog("Starting activateCamera…")
+            DriverInstallManager.shared.activateCamera { result in
+                switch result {
+                case .success(let message):
+                    appendLog("OK: \(message)")
+                    fputs("[ASFW] \(message)\n", stderr)
+                case .failure(let error):
+                    let detail = DriverInstallManager.describe(error)
+                    appendLog("FAIL: \(detail)")
+                    fputs("[ASFW] install failed: \(detail)\n", stderr)
+                }
+            }
+            return
+        }
+
+        appendLog("Starting activateAll…")
+        DriverInstallManager.shared.activateAll { result in
+            switch result {
+            case .success(let message):
+                appendLog("OK: \(message)")
+                fputs("[ASFW] \(message)\n", stderr)
+            case .failure(let error):
+                let detail = DriverInstallManager.describe(error)
+                appendLog("FAIL: \(detail)")
+                fputs("[ASFW] install failed: \(detail)\n", stderr)
+            }
+        }
+    }
+
+    private static func appendLog(_ line: String) {
+        let stamped = "\(Date()): \(line)\n"
+        guard let data = stamped.data(using: .utf8) else { return }
+        if FileManager.default.fileExists(atPath: logURL.path),
+           let handle = try? FileHandle(forWritingTo: logURL) {
+            defer { try? handle.close() }
+            _ = try? handle.seekToEnd()
+            _ = try? handle.write(contentsOf: data)
+        } else {
+            try? data.write(to: logURL)
+        }
+    }
+}
