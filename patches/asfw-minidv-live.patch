diff --git a/ASFWCamera/ASFWCameraProvider.swift b/ASFWCamera/ASFWCameraProvider.swift
new file mode 100644
index 0000000..1bc8083
--- /dev/null
+++ b/ASFWCamera/ASFWCameraProvider.swift
@@ -0,0 +1,420 @@
+//
+//  ASFWCameraProvider.swift
+//  ASFWCamera
+//
+//  CMIO camera extension: publishes "Sony DCR-PC115E".
+//  Frames are fed by the ASFW host app through a sink stream (no DriverKit
+//  in this process — required for Personal Team Development signing).
+//
+
+import CoreMedia
+import CoreMediaIO
+import CoreVideo
+import Foundation
+import IOKit.audio
+import os.log
+
+private let log = Logger(subsystem: "net.mrmidi.ASFW.ASFWCamera", category: "Provider")
+
+private let kDeviceName = "Sony DCR-PC115E"
+private let kDefaultWidth: Int32 = 720
+private let kDefaultHeight: Int32 = 576
+private let kDefaultRate: Int32 = 25
+
+/// Host app polls this on the source stream to learn when Photo Booth / Zoom is consuming.
+private let kStreamingProperty = CMIOExtensionProperty(rawValue: "4cc_just_glob_0000")
+
+// MARK: - Device
+
+final class ASFWCameraDeviceSource: NSObject, CMIOExtensionDeviceSource {
+    private(set) var device: CMIOExtensionDevice!
+    private var streamSource: ASFWCameraStreamSource!
+    private var streamSink: ASFWCameraStreamSink!
+
+    private var streamingCount: UInt32 = 0
+    private var sinkCount: UInt32 = 0
+    private var sinkStarted = false
+
+    func streamingCounterString() -> String { "sc=\(streamingCount)" }
+
+    private var videoDescription: CMFormatDescription!
+    private var streamFormat: CMIOExtensionStreamFormat!
+    private var bufferPool: CVPixelBufferPool!
+    private var bufferAuxAttributes: NSDictionary = [kCVPixelBufferPoolAllocationThresholdKey: 5]
+    private var timer: DispatchSourceTimer?
+    private let timerQueue = DispatchQueue(label: "net.mrmidi.ASFW.ASFWCamera.timer", qos: .userInteractive)
+
+    override init() {
+        super.init()
+        let deviceID = UUID()
+        device = CMIOExtensionDevice(
+            localizedName: kDeviceName,
+            deviceID: deviceID,
+            legacyDeviceID: deviceID.uuidString,
+            source: self
+        )
+
+        rebuildFormat(width: kDefaultWidth, height: kDefaultHeight, rate: kDefaultRate)
+
+        let sourceID = UUID()
+        streamSource = ASFWCameraStreamSource(
+            localizedName: "\(kDeviceName) Video",
+            streamID: sourceID,
+            streamFormat: streamFormat,
+            device: device
+        )
+        let sinkID = UUID()
+        streamSink = ASFWCameraStreamSink(
+            localizedName: "\(kDeviceName) Sink",
+            streamID: sinkID,
+            streamFormat: streamFormat,
+            device: device
+        )
+        do {
+            try device.addStream(streamSource.stream)
+            try device.addStream(streamSink.stream)
+        } catch {
+            fatalError("Failed to add stream: \(error.localizedDescription)")
+        }
+    }
+
+    var availableProperties: Set<CMIOExtensionProperty> {
+        [.deviceTransportType, .deviceModel]
+    }
+
+    func deviceProperties(forProperties properties: Set<CMIOExtensionProperty>) throws -> CMIOExtensionDeviceProperties {
+        let props = CMIOExtensionDeviceProperties(dictionary: [:])
+        if properties.contains(.deviceTransportType) {
+            props.transportType = Int(kIOAudioDeviceTransportTypeFireWire)
+        }
+        if properties.contains(.deviceModel) {
+            props.model = "DCR-PC115E"
+        }
+        return props
+    }
+
+    func setDeviceProperties(_ deviceProperties: CMIOExtensionDeviceProperties) throws {}
+
+    func startStreaming() {
+        streamingCount += 1
+        guard streamingCount == 1 else { return }
+        guard bufferPool != nil else { return }
+
+        let t = DispatchSource.makeTimerSource(flags: .strict, queue: timerQueue)
+        t.schedule(deadline: .now(), repeating: 1.0 / Double(kDefaultRate), leeway: .milliseconds(5))
+        t.setEventHandler { [weak self] in
+            self?.emitPlaceholderIfNeeded()
+        }
+        timer = t
+        t.resume()
+        log.info("Source streaming started")
+    }
+
+    func stopStreaming() {
+        if streamingCount > 1 {
+            streamingCount -= 1
+            return
+        }
+        streamingCount = 0
+        timer?.cancel()
+        timer = nil
+        log.info("Source streaming stopped")
+    }
+
+    func startStreamingSink(client: CMIOExtensionClient) {
+        sinkCount += 1
+        sinkStarted = true
+        consumeSink(client)
+        log.info("Sink streaming started")
+    }
+
+    func stopStreamingSink() {
+        sinkStarted = false
+        if sinkCount > 1 {
+            sinkCount -= 1
+        } else {
+            sinkCount = 0
+        }
+        log.info("Sink streaming stopped")
+    }
+
+    private func rebuildFormat(width: Int32, height: Int32, rate: Int32) {
+        let par: NSDictionary = [
+            kCMFormatDescriptionKey_PixelAspectRatioHorizontalSpacing: 16,
+            kCMFormatDescriptionKey_PixelAspectRatioVerticalSpacing: 15
+        ]
+        let extensions: NSDictionary = [
+            kCMFormatDescriptionExtension_PixelAspectRatio: par
+        ]
+        var format: CMFormatDescription?
+        CMVideoFormatDescriptionCreate(
+            allocator: kCFAllocatorDefault,
+            codecType: kCVPixelFormatType_32BGRA,
+            width: width,
+            height: height,
+            extensions: extensions,
+            formatDescriptionOut: &format
+        )
+        videoDescription = format
+        streamFormat = CMIOExtensionStreamFormat(
+            formatDescription: videoDescription,
+            maxFrameDuration: CMTime(value: 1, timescale: rate),
+            minFrameDuration: CMTime(value: 1, timescale: rate),
+            validFrameDurations: nil
+        )
+
+        let attrs: NSDictionary = [
+            kCVPixelBufferWidthKey: width,
+            kCVPixelBufferHeightKey: height,
+            kCVPixelBufferPixelFormatTypeKey: kCVPixelFormatType_32BGRA,
+            kCVPixelBufferIOSurfacePropertiesKey: [:] as NSDictionary
+        ]
+        var pool: CVPixelBufferPool?
+        CVPixelBufferPoolCreate(kCFAllocatorDefault, nil, attrs, &pool)
+        bufferPool = pool
+    }
+
+    private func emitPlaceholderIfNeeded() {
+        guard !sinkStarted, streamingCount > 0 else { return }
+        var pixelBuffer: CVPixelBuffer?
+        let err = CVPixelBufferPoolCreatePixelBufferWithAuxAttributes(
+            kCFAllocatorDefault, bufferPool, bufferAuxAttributes, &pixelBuffer
+        )
+        guard err == 0, let pixelBuffer else { return }
+
+        CVPixelBufferLockBaseAddress(pixelBuffer, [])
+        if let base = CVPixelBufferGetBaseAddress(pixelBuffer) {
+            let h = CVPixelBufferGetHeight(pixelBuffer)
+            let bpr = CVPixelBufferGetBytesPerRow(pixelBuffer)
+            memset(base, 0x20, bpr * h)
+        }
+        CVPixelBufferUnlockBaseAddress(pixelBuffer, [])
+
+        send(pixelBuffer: pixelBuffer)
+    }
+
+    private func send(pixelBuffer: CVPixelBuffer) {
+        var timing = CMSampleTimingInfo(
+            duration: CMTime(value: 1, timescale: kDefaultRate),
+            presentationTimeStamp: CMClockGetTime(CMClockGetHostTimeClock()),
+            decodeTimeStamp: .invalid
+        )
+        var sampleBuffer: CMSampleBuffer?
+        let err = CMSampleBufferCreateForImageBuffer(
+            allocator: kCFAllocatorDefault,
+            imageBuffer: pixelBuffer,
+            dataReady: true,
+            makeDataReadyCallback: nil,
+            refcon: nil,
+            formatDescription: videoDescription,
+            sampleTiming: &timing,
+            sampleBufferOut: &sampleBuffer
+        )
+        guard err == noErr, let sampleBuffer else { return }
+        let hostNs = UInt64(timing.presentationTimeStamp.seconds * Double(NSEC_PER_SEC))
+        streamSource.stream.send(sampleBuffer, discontinuity: [], hostTimeInNanoseconds: hostNs)
+    }
+
+    private func consumeSink(_ client: CMIOExtensionClient) {
+        guard sinkStarted else { return }
+        streamSink.stream.consumeSampleBuffer(from: client) { [weak self] sbuf, seq, _, _, error in
+            guard let self else { return }
+            if let sbuf {
+                let now = CMClockGetTime(CMClockGetHostTimeClock())
+                if self.streamingCount > 0 {
+                    self.streamSource.stream.send(
+                        sbuf,
+                        discontinuity: [],
+                        hostTimeInNanoseconds: UInt64(now.seconds * Double(NSEC_PER_SEC))
+                    )
+                }
+                let output = CMIOExtensionScheduledOutput(
+                    sequenceNumber: seq,
+                    hostTimeInNanoseconds: UInt64(now.seconds * Double(NSEC_PER_SEC))
+                )
+                self.streamSink.stream.notifyScheduledOutputChanged(output)
+            } else if let error {
+                log.error("consumeSampleBuffer: \(error.localizedDescription, privacy: .public)")
+            }
+            self.consumeSink(client)
+        }
+    }
+}
+
+// MARK: - Source stream
+
+final class ASFWCameraStreamSource: NSObject, CMIOExtensionStreamSource {
+    private(set) var stream: CMIOExtensionStream!
+    let device: CMIOExtensionDevice
+    private var streamFormat: CMIOExtensionStreamFormat
+    var activeFormatIndex: Int = 0
+
+    init(localizedName: String, streamID: UUID, streamFormat: CMIOExtensionStreamFormat, device: CMIOExtensionDevice) {
+        self.device = device
+        self.streamFormat = streamFormat
+        super.init()
+        stream = CMIOExtensionStream(
+            localizedName: localizedName,
+            streamID: streamID,
+            direction: .source,
+            clockType: .hostTime,
+            source: self
+        )
+    }
+
+    var formats: [CMIOExtensionStreamFormat] { [streamFormat] }
+
+    var availableProperties: Set<CMIOExtensionProperty> {
+        [.streamActiveFormatIndex, .streamFrameDuration, kStreamingProperty]
+    }
+
+    private var justEcho = "idle"
+
+    func streamProperties(forProperties properties: Set<CMIOExtensionProperty>) throws -> CMIOExtensionStreamProperties {
+        let props = CMIOExtensionStreamProperties(dictionary: [:])
+        if properties.contains(.streamActiveFormatIndex) { props.activeFormatIndex = 0 }
+        if properties.contains(.streamFrameDuration) { props.frameDuration = streamFormat.minFrameDuration }
+        if properties.contains(kStreamingProperty) {
+            let value: String
+            if let deviceSource = device.source as? ASFWCameraDeviceSource {
+                value = deviceSource.streamingCounterString()
+            } else {
+                value = justEcho
+            }
+            props.setPropertyState(CMIOExtensionPropertyState(value: value as NSString), forProperty: kStreamingProperty)
+        }
+        return props
+    }
+
+    func setStreamProperties(_ streamProperties: CMIOExtensionStreamProperties) throws {
+        if let idx = streamProperties.activeFormatIndex { activeFormatIndex = idx }
+        if let state = streamProperties.propertiesDictionary[kStreamingProperty],
+           let newValue = state.value as? String {
+            justEcho = newValue
+            if let deviceSource = device.source as? ASFWCameraDeviceSource {
+                justEcho = deviceSource.streamingCounterString()
+            }
+        }
+    }
+
+    func authorizedToStartStream(for client: CMIOExtensionClient) -> Bool { true }
+
+    func startStream() throws {
+        guard let deviceSource = device.source as? ASFWCameraDeviceSource else {
+            throw NSError(domain: "ASFWCamera", code: 1)
+        }
+        deviceSource.startStreaming()
+    }
+
+    func stopStream() throws {
+        guard let deviceSource = device.source as? ASFWCameraDeviceSource else {
+            throw NSError(domain: "ASFWCamera", code: 1)
+        }
+        deviceSource.stopStreaming()
+    }
+}
+
+// MARK: - Sink stream
+
+final class ASFWCameraStreamSink: NSObject, CMIOExtensionStreamSource {
+    private(set) var stream: CMIOExtensionStream!
+    let device: CMIOExtensionDevice
+    private let streamFormat: CMIOExtensionStreamFormat
+    var activeFormatIndex: Int = 0
+    private var client: CMIOExtensionClient?
+
+    init(localizedName: String, streamID: UUID, streamFormat: CMIOExtensionStreamFormat, device: CMIOExtensionDevice) {
+        self.device = device
+        self.streamFormat = streamFormat
+        super.init()
+        stream = CMIOExtensionStream(
+            localizedName: localizedName,
+            streamID: streamID,
+            direction: .sink,
+            clockType: .hostTime,
+            source: self
+        )
+    }
+
+    var formats: [CMIOExtensionStreamFormat] { [streamFormat] }
+
+    var availableProperties: Set<CMIOExtensionProperty> {
+        [
+            .streamActiveFormatIndex,
+            .streamFrameDuration,
+            .streamSinkBufferQueueSize,
+            .streamSinkBuffersRequiredForStartup,
+            .streamSinkBufferUnderrunCount,
+            .streamSinkEndOfData
+        ]
+    }
+
+    func streamProperties(forProperties properties: Set<CMIOExtensionProperty>) throws -> CMIOExtensionStreamProperties {
+        let props = CMIOExtensionStreamProperties(dictionary: [:])
+        if properties.contains(.streamActiveFormatIndex) { props.activeFormatIndex = 0 }
+        if properties.contains(.streamFrameDuration) {
+            props.frameDuration = CMTime(value: 1, timescale: kDefaultRate)
+        }
+        if properties.contains(.streamSinkBufferQueueSize) { props.sinkBufferQueueSize = 1 }
+        if properties.contains(.streamSinkBuffersRequiredForStartup) { props.sinkBuffersRequiredForStartup = 1 }
+        return props
+    }
+
+    func setStreamProperties(_ streamProperties: CMIOExtensionStreamProperties) throws {
+        if let idx = streamProperties.activeFormatIndex { activeFormatIndex = idx }
+    }
+
+    func authorizedToStartStream(for client: CMIOExtensionClient) -> Bool {
+        self.client = client
+        return true
+    }
+
+    func startStream() throws {
+        guard let deviceSource = device.source as? ASFWCameraDeviceSource else {
+            throw NSError(domain: "ASFWCamera", code: 1)
+        }
+        if let client {
+            deviceSource.startStreamingSink(client: client)
+        }
+    }
+
+    func stopStream() throws {
+        guard let deviceSource = device.source as? ASFWCameraDeviceSource else {
+            throw NSError(domain: "ASFWCamera", code: 1)
+        }
+        deviceSource.stopStreamingSink()
+    }
+}
+
+// MARK: - Provider
+
+final class ASFWCameraProviderSource: NSObject, CMIOExtensionProviderSource {
+    private(set) var provider: CMIOExtensionProvider!
+    private var deviceSource: ASFWCameraDeviceSource!
+
+    init(clientQueue: DispatchQueue?) {
+        super.init()
+        provider = CMIOExtensionProvider(source: self, clientQueue: clientQueue)
+        deviceSource = ASFWCameraDeviceSource()
+        do {
+            try provider.addDevice(deviceSource.device)
+        } catch {
+            fatalError("Failed to add device: \(error.localizedDescription)")
+        }
+    }
+
+    func connect(to client: CMIOExtensionClient) throws {}
+    func disconnect(from client: CMIOExtensionClient) {}
+
+    var availableProperties: Set<CMIOExtensionProperty> { [.providerManufacturer] }
+
+    func providerProperties(forProperties properties: Set<CMIOExtensionProperty>) throws -> CMIOExtensionProviderProperties {
+        let props = CMIOExtensionProviderProperties(dictionary: [:])
+        if properties.contains(.providerManufacturer) {
+            props.manufacturer = "Sony / ASFireWire"
+        }
+        return props
+    }
+
+    func setProviderProperties(_ providerProperties: CMIOExtensionProviderProperties) throws {}
+}
