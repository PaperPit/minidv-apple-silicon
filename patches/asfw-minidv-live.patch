diff --git a/ASFWCamera/load-camera-agent.sh b/ASFWCamera/load-camera-agent.sh
new file mode 100755
index 0000000..aad85af
--- /dev/null
+++ b/ASFWCamera/load-camera-agent.sh
@@ -0,0 +1,32 @@
+#!/usr/bin/env bash
+# Point LaunchAgent at the newest activated ASFWCamera system extension and load it.
+set -Eeuo pipefail
+
+LABEL=net.mrmidi.ASFW.ASFWCamera
+AGENT_SRC="$(cd "$(dirname "$0")" && pwd)/net.mrmidi.ASFW.ASFWCamera.plist"
+AGENT_DST="$HOME/Library/LaunchAgents/${LABEL}.plist"
+LINK_DIR=/Library/SystemExtensions/CurrentASFWCamera
+
+EXT="$(ls -dt /Library/SystemExtensions/*/net.mrmidi.ASFW.ASFWCamera.systemextension 2>/dev/null | head -1 || true)"
+[[ -n "$EXT" && -d "$EXT" ]] || { echo "No activated ASFWCamera.systemextension found. Run ASFW --install-extensions first."; exit 1; }
+
+echo "Using $EXT"
+sudo mkdir -p /Library/SystemExtensions
+sudo rm -f "$LINK_DIR"
+sudo ln -sfn "$EXT" "$LINK_DIR"
+
+mkdir -p "$HOME/Library/LaunchAgents"
+cp "$AGENT_SRC" "$AGENT_DST"
+# Rewrite program path to the linked binary
+BIN="$LINK_DIR/Contents/MacOS/net.mrmidi.ASFW.ASFWCamera"
+/usr/libexec/PlistBuddy -c "Set :ProgramArguments:0 $BIN" "$AGENT_DST"
+
+launchctl bootout "gui/$(id -u)/${LABEL}" 2>/dev/null || true
+launchctl bootstrap "gui/$(id -u)" "$AGENT_DST"
+launchctl enable "gui/$(id -u)/${LABEL}" 2>/dev/null || true
+launchctl kickstart -k "gui/$(id -u)/${LABEL}" 2>/dev/null || launchctl start "$LABEL" || true
+
+sleep 1
+launchctl print "gui/$(id -u)/${LABEL}" 2>/dev/null | head -30 || true
+echo "Camera agent loaded. Check Photo Booth for Sony DCR-PC115E."
+echo "Logs: /tmp/asfw-camera.log /tmp/asfw-camera.err"
